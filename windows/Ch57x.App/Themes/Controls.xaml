<!--
  Fluent 2 모양 (직접 만든 ResourceDictionary · 외부 라이브러리 없음). 값 = projects/ch57x/DESIGN.md:
  모서리 컨트롤 4 · 창 · 메뉴 8 / 컨트롤 높이 32(ButtonPadding 11,5,11,6 + 줄 20) / 간격 4 배수 / 글자 본문 14/20 · 캡션 12/16 · 소제목 20/28.
  색은 Light.xaml · Dark.xaml 의 같은 이름(DynamicResource — 테마를 바꾸면 바로 바뀜). 강조색(Accent*)은 ThemeManager 가 넣는다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Ch57x.App">

    <!-- 시스템 글꼴: Segoe UI Variable → Segoe UI → 맑은 고딕 (글꼴 파일을 넣지 않음) -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
    <CornerRadius x:Key="ControlCorner">4</CornerRadius>
    <CornerRadius x:Key="OverlayCorner">8</CornerRadius>
    <!-- 창 둥근 모서리 · 테두리: 실제 창은 Windows 11 이 그린다(0). 화면 렌더 모드만 8 · 1 로 바꿔 그림에 넣는다. -->
    <CornerRadius x:Key="WindowCorner">0</CornerRadius>
    <Thickness x:Key="WindowBorderThickness">0</Thickness>

    <!-- 키보드 포커스 표시 (Fluent: 2px 바깥 선) -->
    <Style x:Key="FluentFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource T1}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 글자 -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T2}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Strong" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldHeader" TargetType="TextBlock" BasedOn="{StaticResource Strong}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- 창: 직접 그린 제목 표시줄(아이콘 · 제목 · 최소화 · 닫기) — 최대화 없음(판정 E7 · D8) -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <local:Glyph Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <local:Glyph x:Name="G" Kind="x" Size="16" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHover}"/>
                            <Setter TargetName="G" Property="Foreground" Value="{DynamicResource CaptionCloseFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentWindowStyle" TargetType="local:FluentWindow">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:FluentWindow">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource WindowCorner}"
                            BorderBrush="{DynamicResource SurfaceStroke}" BorderThickness="{DynamicResource WindowBorderThickness}" ClipToBounds="True">
                        <DockPanel>
                            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="{TemplateBinding TitleBarBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{DynamicResource AppIcon16}" Width="16" Height="16" Margin="12,0,12,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource T1}" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="MinBtn" Grid.Column="2" Style="{StaticResource CaptionButton}" Tag="min"
                                        Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="최소화"
                                        AutomationProperties.Name="최소화"/>
                                <Button Grid.Column="3" Style="{StaticResource CaptionCloseButton}"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="닫기"
                                        AutomationProperties.Name="닫기"/>
                            </Grid>
                            <AdornerDecorator>
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinBtn" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 단추: 기본 · 강조(Accent · 화면당 하나) · 바탕 없음(Subtle) · 아이콘만 · 위험 글자.  Tag = 아이콘 이름(있으면 글자 앞에) -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="11,0,11,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Background" Value="{DynamicResource CtrlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CtrlElevationBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <local:Glyph x:Name="Ico" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,8,0"/>
                            <ContentPresenter x:Name="Cp" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Margin" Value="0"/>
                            <Setter TargetName="Cp" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill3}"/>
                            <Setter Property="Foreground" Value="{DynamicResource T2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFillDis}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TDis}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentElevationBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <local:Glyph x:Name="Ico" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,8,0"/>
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDis}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentDis}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <local:Glyph x:Name="Ico" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="0,0,8,0"/>
                            <ContentPresenter x:Name="Cp" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Margin" Value="0"/>
                            <Setter TargetName="Cp" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TDis}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="CriticalButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Critical}"/>
    </Style>

    <!-- 고르기 목록처럼 보이는 단추 (프로필 — 누르면 프로필 목록 메뉴 · 판정 S9 · S13) -->
    <Style x:Key="ComboButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="11,0,8,0" SnapsToDevicePixels="True">
                        <DockPanel>
                            <local:Glyph x:Name="Chev" DockPanel.Dock="Right" Kind="chev" Size="16" Margin="8,0,0,0" Foreground="{DynamicResource T2}"/>
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill3}"/>
                        </Trigger>
                        <!-- 업로드 중 잠금 (첫 사용 점검 5번) — ButtonBase 와 같은 Fluent 비활성 색 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFillDis}"/>
                            <Setter TargetName="Chev" Property="Foreground" Value="{DynamicResource TDis}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TDis}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HUD 머리 단추 24 (판정 H7 — 세 단추 같은 크기) -->
    <Style x:Key="HudButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource T2}"/>
        <Setter Property="Background" Value="{DynamicResource CtrlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CtrlStroke}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <local:Glyph Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="14" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource T1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 키 칸 · 노브 칸: 테두리 = 그 레이어의 LED 색(판정 E3 — 코드가 BorderBrush 를 넣음) -->
    <Style x:Key="KeyCell" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Background" Value="{DynamicResource CtrlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CtrlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 레이어 고르기 (판정 E8: 채움 없음 · 굵은 글자 + 아래 표시줄 · 점 = LED 색). Tag = LED 색 붓 -->
    <Style x:Key="LayerTab" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource T2}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,0,12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="Pill" Width="16" Height="3" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource T1}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 체크 상자 · 라디오 (판정 D5: 색만으로 구분하지 않음 — 표지 모양으로) -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource StrongStroke}" Background="{DynamicResource AltFill}"/>
                            <local:Glyph x:Name="Mark" Kind="check" Size="16" Foreground="{DynamicResource OnAccent}" Visibility="Collapsed" HorizontalAlignment="Center"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AltFill2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1" Stroke="{DynamicResource StrongStroke}" Fill="{DynamicResource AltFill}"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource OnAccent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AltFill2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="0"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 입력 칸 · Tag = 빈 칸 안내 글 -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource T1}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,5,10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{DynamicResource CtrlFill}" BorderBrush="{DynamicResource CtrlStroke}" SnapsToDevicePixels="True"/>
                        <!-- 아래 1px 진한 선 (WinUI TextControlElevationBorder 모양). 기울기 붓 흉내는 높은 칸(상용구 64)에서 옆선 절반이 진해져 버림 — CI 렌더 실측 -->
                        <Border Height="1" VerticalAlignment="Bottom" Margin="1,0,1,0" Background="{DynamicResource StrongStroke}" SnapsToDevicePixels="True"/>
                        <!-- 여백(Padding)은 TextBox 가 안쪽에서 직접 쓴다 — 여기서 또 주면 두 번 들어감(0.3.0 CI 렌더 실측) -->
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Stretch" Focusable="False"/>
                        <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource T3}" Margin="12,5,10,6" IsHitTestVisible="False"
                                   VerticalAlignment="Top" Visibility="Collapsed"/>
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFill}"/>
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 (⋯ 메뉴 · 프로필 목록 · 테마) -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="HorizontalOffset" Value="-12"/>
        <Setter Property="VerticalOffset" Value="-8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12,8,12,16" Background="{DynamicResource Bg4}" BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="8" Padding="4"
                            MinWidth="{TemplateBinding MinWidth}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.18"/>
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="-4,4,-4,4" Background="{DynamicResource Divider}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 줄: 높이 32 · 아이콘 16(Tag = 아이콘 이름) · 체크 · 하위 메뉴 화살표. Tag="radio" = 동그라미 표지 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Height="32" CornerRadius="4" Background="Transparent" Padding="12,0,12,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:Glyph x:Name="Ico" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16" Foreground="{DynamicResource T2}"/>
                            <local:Glyph x:Name="Check" Kind="check" Size="16" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <local:Glyph x:Name="Arrow" Grid.Column="3" Kind="chev-r" Size="16" Margin="24,0,0,0" Foreground="{DynamicResource T2}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Left" AllowsTransparency="True" Focusable="False" HorizontalOffset="0" VerticalOffset="-13"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                                <Border Margin="12,8,12,16" Background="{DynamicResource Bg4}" BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="168">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="Tag" Value="radio"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Check" Property="Kind" Value="dot"/>
                        </MultiTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TDis}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CriticalMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource Critical}"/>
    </Style>

    <!-- 고르기 목록 -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{DynamicResource CtrlFill}" BorderBrush="{DynamicResource CtrlElevationBorder}" SnapsToDevicePixels="True">
                        <local:Glyph Kind="chev" Size="16" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{DynamicResource T2}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CtrlFill3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                        <ContentPresenter Margin="11,0,32,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" VerticalOffset="-4" HorizontalOffset="-12"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                            <Border Margin="12,8,12,16" Background="{DynamicResource Bg4}" BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="8" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" MinHeight="32" CornerRadius="4" Background="Transparent" Padding="12,0,12,0">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Subtle2}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 접이 칸 (정보 창 「업데이트」 · 「문제 해결」 — 판정 A1 · A3 · A4). Tag = 머리 아이콘 -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource Card}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          FocusVisualStyle="{StaticResource FluentFocus}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Height="48" Background="Transparent" Padding="16,0,16,0">
                                            <DockPanel>
                                                <local:Glyph DockPanel.Dock="Left" Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Size="16" Margin="0,0,12,0" Foreground="{DynamicResource T2}"/>
                                                <local:Glyph x:Name="Chev" DockPanel.Dock="Right" Kind="chev" Size="16" Foreground="{DynamicResource T2}"/>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chev" Property="Kind" Value="chev-up"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Body" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource Bg3}" Padding="16,12,16,16"
                                    CornerRadius="0,0,4,4" Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 진행 막대 (업로드 중 · 판정 S4) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource StrongStroke}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 밀대 (HUD 크기 · 투명도) -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Height="20">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderRepeat}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderRepeat}" Background="{DynamicResource StrongStroke}" Command="Slider.IncreaseLarge"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="20" Height="20">
                                            <Ellipse Fill="{DynamicResource Bg4}" Stroke="{DynamicResource CtrlStroke}" StrokeThickness="1"/>
                                            <Ellipse x:Name="In" Width="10" Height="10" Fill="{DynamicResource Accent}"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="In" Property="Width" Value="12"/>
                                                <Setter TargetName="In" Property="Height" Value="12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 스크롤 막대 (가늘게) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="4" CornerRadius="2" Background="{DynamicResource T3}" Margin="0,2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource T3}" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource T1}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Bg4}" BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="4" Padding="8,5,8,6" MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 카드 · 나눔선 (열쇠 이름이 색 Card · Divider 와 겹치지 않게 — 겹치면 색 자리에 Style 이 들어감: 0.3.0 첫 CI 렌더 실측) -->
    <Style x:Key="CardBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style x:Key="DividerLine" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Divider}"/>
    </Style>
</ResourceDictionary>
