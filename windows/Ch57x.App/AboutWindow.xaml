<local:FluentWindow x:Class="Ch57x.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch57x.App"
        Title="정보" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <!-- 정보 창 (판정 A1 업데이트 칸 따로 · A2 닫기는 아래 오른쪽 혼자 · A3 본문 14 · A4 설치 명령은 「명령 보기」로 접음) -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16,24,16" BorderThickness="0,1,0,0" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource CardStroke}">
            <Button x:Name="BtnClose" Content="닫기" Width="120" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Border>
        <StackPanel Margin="24,8,24,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource AppIcon48}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="CH57x 설정기" FontSize="20" FontWeight="SemiBold" LineHeight="28"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="DescText" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <StackPanel Margin="0,8,0,0">
                <TextBlock Height="32" Padding="0,6,0,0"><Hyperlink x:Name="LinkRepo" NavigateUri="https://github.com/happy4ed/ch57x-configurator" Foreground="{DynamicResource Accent}" TextDecorations="{x:Null}">소스 · 업데이트 — GitHub</Hyperlink></TextBlock>
                <TextBlock Height="32" Padding="0,6,0,0"><Hyperlink x:Name="LinkWeb" NavigateUri="https://happy4ed.github.io/ch57x-configurator/" Foreground="{DynamicResource Accent}" TextDecorations="{x:Null}">웹 버전 — 설치 없이 쓰기</Hyperlink></TextBlock>
                <TextBlock Height="32" Padding="0,6,0,0"><Hyperlink x:Name="LinkUpstream" NavigateUri="https://github.com/kriomant/ch57x-keyboard-tool" Foreground="{DynamicResource Accent}" TextDecorations="{x:Null}">프로토콜 기반 — kriomant/ch57x-keyboard-tool</Hyperlink></TextBlock>
            </StackPanel>
            <Border Height="16"/>
            <Expander x:Name="UpdateBox" Header="업데이트" Tag="upload">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="PowerShell 에 설치 명령을 붙여 넣으면 최신 판으로 다시 설치됨. 프로필은 그대로."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnCopyInstall" Tag="copy" Content="설치 명령 복사"/>
                        <Button x:Name="BtnShowCmd" Style="{StaticResource SubtleButton}" Content="명령 보기" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="InstallCmdText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="13"
                             MaxHeight="120" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="설치 명령"/>
                </StackPanel>
            </Expander>
            <Border Height="8"/>
            <Expander x:Name="TroubleBox" Header="문제 해결" Tag="info">
                <StackPanel>
                    <TextBlock Text="실행 파일" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="ExePathText" TextWrapping="Wrap"/>
                    <TextBlock Text="자동실행" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AutoStartText" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnCopy" Tag="copy" Content="정보 복사"/>
                        <Button x:Name="BtnProfiles" Tag="pc-load" Content="프로필 폴더 열기" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </DockPanel>
</local:FluentWindow>
