<Window x:Class="Ch57x.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="정보" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0f1115" Foreground="#e6e9ef" FontSize="14">
    <StackPanel Margin="20">

        <!-- 이름 · 버전 -->
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="CH57x 설정기" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Text="" Foreground="#8b93a1" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="DescText" Text="" Foreground="#c3c9d4" TextWrapping="Wrap" Margin="0,14,0,0"/>

        <Separator Margin="0,16,0,12" Background="#2a2f3a"/>

        <!-- 저작권 · 라이선스 -->
        <TextBlock x:Name="CopyrightText" Text="" Margin="0,0,0,4"/>
        <TextBlock Foreground="#8b93a1" TextWrapping="Wrap"
                   Text="이 프로그램은 MIT 라이선스로 배포됩니다. 무보증(AS IS)이며 사용에 따른 책임은 사용자에게 있습니다."/>

        <TextBlock Margin="0,12,0,0" Foreground="#8b93a1" TextWrapping="Wrap">
            <Run Text="프로토콜 기반: "/>
            <Hyperlink x:Name="LinkUpstream" NavigateUri="https://github.com/kriomant/ch57x-keyboard-tool"
                       Foreground="#f0a92e">kriomant/ch57x-keyboard-tool</Hyperlink>
            <Run Text=" (MIT). 읽기·개수 조회 명령은 벤더 앱 분석으로 확인."/>
        </TextBlock>

        <TextBlock Margin="0,6,0,0">
            <Run Text="소스·업데이트: " Foreground="#8b93a1"/>
            <Hyperlink x:Name="LinkRepo" NavigateUri="https://github.com/happy4ed/ch57x-configurator"
                       Foreground="#f0a92e">github.com/happy4ed/ch57x-configurator</Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,6,0,0">
            <Run Text="웹 버전(설치 없이): " Foreground="#8b93a1"/>
            <Hyperlink x:Name="LinkWeb" NavigateUri="https://happy4ed.github.io/ch57x-configurator/"
                       Foreground="#f0a92e">happy4ed.github.io/ch57x-configurator</Hyperlink>
        </TextBlock>

        <Separator Margin="0,16,0,12" Background="#2a2f3a"/>

        <!-- 이 PC 에서의 실제 위치 — 문제 생겼을 때 사람이 확인할 자리 -->
        <TextBlock Text="이 PC 에서" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock x:Name="ExePathText" Foreground="#8b93a1" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
        <TextBlock x:Name="AutoStartText" Foreground="#8b93a1" TextWrapping="Wrap" FontSize="12"/>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnProfiles" Content="프로필 폴더 열기" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="BtnCopy" Content="정보 복사" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="BtnClose" Content="닫기" Padding="12,6" IsDefault="True" IsCancel="True"/>
        </WrapPanel>
    </StackPanel>
</Window>
