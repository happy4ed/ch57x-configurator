<local:FluentWindow x:Class="Ch57x.App.KeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch57x.App"
        Title="CH57x 설정기 — 키 설정"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <!-- 메인 창 = 키 설정 (판정 M1 원문 "메인은 키 설정이여야 함"). 고정 크기(E7) — 키 · 노브 개수에 맞춰 크기가 정해지고 사용자가 늘리지 않음. -->
    <StackPanel Margin="16,4,16,16">
        <!-- 머리 줄: 프로필 · 연결 상태 · ⋯ (E1: 상태는 제목 표시줄이 아니라 여기) -->
        <DockPanel Height="40" LastChildFill="False">
            <TextBlock Text="프로필" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
            <Button x:Name="ProfileBtn" Style="{StaticResource ComboButton}" Width="200" Height="32" VerticalAlignment="Center" AutomationProperties.Name="프로필 목록"/>
            <Button x:Name="MoreBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="more" Margin="8,0,0,0"
                    ToolTip="더 보기" AutomationProperties.Name="더 보기"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusCaption" Style="{StaticResource Caption}"/>
            </StackPanel>
        </DockPanel>
        <Border Height="12"/>

        <!-- 알림 줄: 읽기 끝 · 안내 (업로드 끝은 아래 줄 상태 자리 — 위 내용을 밀지 않게 · 첫 사용 점검 6번) -->
        <Border x:Name="InfoBar" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource CardStroke}" MinHeight="48" Padding="12,8,8,8">
            <DockPanel>
                <local:Glyph x:Name="InfoIcon" DockPanel.Dock="Left" Kind="ok" Size="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button x:Name="InfoClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="x" ToolTip="닫기" AutomationProperties.Name="알림 닫기"/>
                <Button x:Name="InfoAction" DockPanel.Dock="Right" Margin="8,0,8,0" Visibility="Collapsed"/>
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 레이어 고르기 (E8 · E3: 점 = 그 레이어의 LED 색) -->
        <StackPanel x:Name="LayerTabs" Orientation="Horizontal" Height="40"/>
        <Border Height="12"/>

        <!-- 장치: 왼쪽 키 · 오른쪽 노브 세로 3줄 (E6 · 실물 배치 해석) -->
        <Border Style="{StaticResource CardBox}" Padding="16">
            <StackPanel x:Name="Device" Orientation="Horizontal"/>
        </Border>
        <Border Height="12"/>

        <!-- 조명 한 줄 (E9) -->
        <StackPanel x:Name="LedRow" Orientation="Horizontal" Height="32">
            <StackPanel Orientation="Horizontal" Width="64" VerticalAlignment="Center">
                <local:Glyph Kind="led" Size="16" Margin="0,0,8,0"/>
                <TextBlock Text="조명" Style="{StaticResource Strong}"/>
            </StackPanel>
            <ComboBox x:Name="LedMode" Width="200" AutomationProperties.Name="조명 방식"/>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Style="{StaticResource DividerLine}" Margin="0,16,0,16"/>
        <!-- 진행 막대 3 — 위 -8 · 아래 5 로 자리 합이 0(나타나도 아래 줄이 움직이지 않음) -->
        <ProgressBar x:Name="Progress" Margin="0,-8,0,5" Minimum="0" Maximum="100" Visibility="Collapsed"/>

        <!-- 아래 줄: 왼쪽 = 되돌리기 성격(바탕 없는 단추) · 오른쪽 = 키보드 읽기 · 쓰기 (같은 줄은 같은 성격) -->
        <DockPanel x:Name="BottomRow" LastChildFill="False">
            <Button x:Name="UndoBtn" Style="{StaticResource SubtleButton}" Tag="undo" Content="실행 취소"/>
            <Button x:Name="LoadPcBtn" Style="{StaticResource SubtleButton}" Tag="pc-load" Content="PC 저장값 불러오기" Margin="8,0,0,0"/>
            <Button x:Name="UploadBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Tag="upload" Content="키보드에 업로드" Margin="8,0,0,0"/>
            <Button x:Name="ReadBtn" DockPanel.Dock="Right" Tag="read" Content="키보드에서 읽기" Margin="8,0,0,0"/>
            <!-- 상태 자리: 「업로드 안 한 변경 n개」 · 업로드 끝 10초(S3). 폭은 최소 160 · 남는 폭까지만(FitStatus) — 글이 바뀌어도 창이 움직이지 않음 -->
            <Border x:Name="StatusSlot" DockPanel.Dock="Right" MinWidth="160" Margin="0,0,8,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <local:Glyph x:Name="DoneIcon" Kind="ok" Size="16" Margin="0,0,8,0" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="PendingText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </StackPanel>
</local:FluentWindow>
